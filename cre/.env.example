# Copy to cre/.env (git-ignored). Real values: local machine / GitHub secrets only.
# Oracle broadcaster key (hex, no 0x). Must be the vault's pinned reportTransmitter
# (testnet 0xe96307086A533Eb4A1eD71AB48b382bD53f129B9); any other key's reports revert. Needs MON for gas.
CRE_ETH_PRIVATE_KEY=
CRE_TARGET=testnet
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
MONAD_MAINNET_RPC=https://rpc.monad.xyz
# YouTube Data API v3 key from the cliprail-oracle Google Cloud project (not the preview key).
YT_API_KEY_ORACLE=
