# Copy to cre/.env (git-ignored). Real values: team vault / GitHub secrets only.
# Oracle broadcaster key (hex, no 0x), from Bitwarden. Must be the vault's pinned reportTransmitter
# (testnet 0x5eF544B1A110CEe1ecbe9DAAA8e578Ad90b8779d); any other key's reports revert. Needs MON for gas.
CRE_ETH_PRIVATE_KEY=
CRE_TARGET=testnet
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
MONAD_MAINNET_RPC=https://rpc.monad.xyz
# YouTube Data API v3 key from the cliprail-oracle Google Cloud project (not the preview key).
YT_API_KEY_ORACLE=
