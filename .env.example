# Networks
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
MONAD_MAINNET_RPC=https://rpc.monad.xyz

# Keys: real values live only in the team vault, Worker secrets, GitHub secrets and Vercel env. Never commit.
RELAYER_PK=
CRE_ETH_PRIVATE_KEY=
CRE_API_KEY=

# APIs
YT_API_KEY_ORACLE=
YT_API_KEY_PREVIEW=
MONADSCAN_API_KEY=

# Web app
NEXT_PUBLIC_NETWORK=testnet
# Passkey domain (rpId). Must never change after launch. Empty = current hostname (local dev).
NEXT_PUBLIC_RP_ID=
# Optional dedicated RPCs for the browser; defaults to the public Monad RPCs.
NEXT_PUBLIC_MONAD_TESTNET_RPC=
NEXT_PUBLIC_MONAD_MAINNET_RPC=
# Dev only: clipper|brand starts a fake signed-in session (no passkey, no real transactions).
NEXT_PUBLIC_MOCK_AUTH=
NEXT_PUBLIC_OPS_URL=
NEXT_PUBLIC_ENVIO_GRAPHQL_URL=

# Extras
NANSEN_API_KEY=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# Indexer (indexer/README.md). Optional: defaults are testnet v0 from packages/abi/addresses.json.
ENVIO_VAULT_10143=
ENVIO_REPUTATION_10143=
ENVIO_START_BLOCK_10143=
# Optional: "Use Google photo" in Edit profile. A Google OAuth web client ID (authorized JS origins: localhost:3000,
# cliprail.vercel.app). Only the profile picture is read; the passkey stays the account's key.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
